# ─── NextAuth (Google OAuth) ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                     # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── 부트스트랩 슈퍼관리자 ─────────────────────────────────────
# Supabase가 비어있어도 ADMIN으로 로그인 가능 (최초 sync 실행용)
# 쉼표로 여러 명 등록 가능
SUPER_ADMIN_EMAILS=he_lee@mobidays.com

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # 절대 클라이언트에 노출 금지

# ─── Google Sheets API (서비스계정) ────────────────────────────
# 메인 시트 — information_employees / 수주프로젝트 아카이빙
GOOGLE_SHEETS_SHEET_ID=1ve6MFc9OMR2EeZQ3AQ4prPHbSv96f3VamiECYMdz5Xg
# 제안 자료 아카이브 — '수주인센티브 대상' 탭, B열(대상여부)='대상' 행만 운영위원회 대상
#   ※ 서비스계정(GOOGLE_SERVICE_ACCOUNT_EMAIL)에 이 시트 '뷰어' 공유 권한이 필요
GOOGLE_SHEETS_ARCHIVE_SHEET_ID=17IBaYyBdfapzAUI9_QRFEaL-Tv75-ykPQ91DMnjMbwI
GOOGLE_SERVICE_ACCOUNT_EMAIL=incentive-bot@your-project.iam.gserviceaccount.com
# private_key는 한 줄에 \n 이스케이프하여 입력 (Vercel UI에 붙여넣기 시 자동 처리됨)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── 수주인센티브 운영위원회 Slack 스레드 ──────────────────────
# 스레드가 생성될 채널 — 기본값 C0CM7MD8MC0 (#수주인센티브)
#   ※ '수주인센티브운영BOT' 이 해당 채널에 초대되어 있어야 함 (/invite @수주인센티브운영BOT)
SLACK_COMMITTEE_CHANNEL_ID=C0CM7MD8MC0
# 운영위원회 담당자 user group ID (S로 시작). 미설정 시 '@incentive-committee' 평문으로 표기
SLACK_COMMITTEE_GROUP_ID=
# 메시지 안 하이퍼링크의 기준 주소 (기본값 https://mobi-incentive.vercel.app)
APP_BASE_URL=https://mobi-incentive.vercel.app
