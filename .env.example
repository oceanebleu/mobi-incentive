# ─── NextAuth (Google OAuth) ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                     # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── 부트스트랩 슈퍼관리자 ─────────────────────────────────────
# Supabase가 비어있어도 ADMIN으로 로그인 가능 (최초 sync 실행용)
# 쉼표로 여러 명 등록 가능
SUPER_ADMIN_EMAILS=he_lee@mobidays.com

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # 절대 클라이언트에 노출 금지

# ─── Google Sheets API (서비스계정) ────────────────────────────
# 메인 시트 — information_employees / 수주프로젝트 아카이빙
GOOGLE_SHEETS_SHEET_ID=1ve6MFc9OMR2EeZQ3AQ4prPHbSv96f3VamiECYMdz5Xg
# 제안 자료 아카이브 — '제안서.2025 Ver' 탭, A열 TRUE 행만 운영위원회 대상
GOOGLE_SHEETS_ARCHIVE_SHEET_ID=1LscohDN8Di-RRz1UJyjFx7xVmgbJrPc6cgD8iQW7Fp8
GOOGLE_SERVICE_ACCOUNT_EMAIL=incentive-bot@your-project.iam.gserviceaccount.com
# private_key는 한 줄에 \n 이스케이프하여 입력 (Vercel UI에 붙여넣기 시 자동 처리됨)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
